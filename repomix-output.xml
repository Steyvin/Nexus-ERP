													{:else}
														<input
															type="text"
															value={String(subVal)}
															oninput={(e) => {
																const target = e.currentTarget as HTMLInputElement;
																(editando[item.id][key] as Record<string, unknown>)[subKey] =
																	target.value;
															}}
															class="param-input"
														/>
													{/if}
												</div>
											{/each}
										</div>
